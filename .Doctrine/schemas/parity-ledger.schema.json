{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doctrine.local/schemas/parity-ledger.schema.json",
  "title": "Floci Parity Ledger",
  "description": "Machine-readable record of every cloud API call a prototype exercised on the Floci emulator, classified by fidelity. Canonicalization: instances are serialized as UTF-8, LF, lexicographically sorted keys, no trailing whitespace, single trailing newline; the ledger hash is sha256 over those canonical bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ledger_version", "generated_at", "floci_version", "manifest_sha256", "demo_run", "calls", "summary"],
  "properties": {
    "ledger_version": { "const": "1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "floci_version": { "type": "string", "minLength": 1 },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "demo_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "output_sha256"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "output_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "calls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "operation", "count", "fidelity", "critical_path"],
        "properties": {
          "service": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 1 },
          "fidelity": { "enum": ["high", "partial", "stub", "unsupported"] },
          "critical_path": { "type": "boolean" },
          "divergence": { "type": "string", "description": "Required in practice when fidelity is partial or stub: the specific behavior that differs on the real cloud." },
          "evidence": { "type": "string", "description": "First-seen trace or log reference from the captured run." }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_calls", "by_fidelity", "gate"],
      "properties": {
        "total_calls": { "type": "integer", "minimum": 1 },
        "by_fidelity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["high", "partial", "stub", "unsupported"],
          "properties": {
            "high": { "type": "integer", "minimum": 0 },
            "partial": { "type": "integer", "minimum": 0 },
            "stub": { "type": "integer", "minimum": 0 },
            "unsupported": { "type": "integer", "minimum": 0 }
          }
        },
        "gate": {
          "enum": ["pass", "warn", "block"],
          "description": "block: any critical-path call is stub or unsupported. warn: any critical-path call is partial. pass: otherwise."
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
